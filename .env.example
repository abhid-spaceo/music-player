# Local: a Postgres on 127.0.0.1. Production: the Neon *pooled* connection
# string from the Vercel marketplace integration.
DATABASE_URL="postgresql://user@127.0.0.1:5432/music_player_dev"

# 32+ random bytes, base64. Rotating this invalidates every session.
#   openssl rand -base64 48
SESSION_SECRET="replace-me"

# YouTube Data API v3 key. Public-data reads only; no billing account needed.
# Phase 2 onward.
YOUTUBE_API_KEY=""

# Region used to evaluate contentDetails.regionRestriction. Must be where you
# actually watch, or tracks get wrongly flagged region_blocked.
YOUTUBE_REGION="IN"

# Leave unset in real environments. Only the verification stub sets this.
# YOUTUBE_API_BASE="http://127.0.0.1:3199/youtube/v3"

# Seeding. In production these are REQUIRED — the seed refuses to plant a
# known-default credential into a real database.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_LISTENER_EMAIL=""
SEED_LISTENER_PASSWORD=""
